{
  "name": "userflex-session-manager",
  "private": true,
  "version": "0.1.11",
  "description": "userFLEX managed Chromium session capture helper",
  "type": "module",
  "main": "entry.js",
  "scripts": {
    "prestart": "node build/harden-cookie-capture.mjs",
    "start": "electron .",
    "predist:win": "node build/harden-cookie-capture.mjs",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "socks": "^2.8.10"
  },
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.userflex.sessionmanager",
    "productName": "userFLEX Session Manager",
    "artifactName": "userFLEX-Session-Manager-${version}-Setup.${ext}",
    "asar": true,
    "electronVersion": "44.1.0+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "files": [
      "entry.js",
      "main.js",
      "proxy-bridge.js",
      "preload.cjs",
      "package.json"
    ],
    "protocols": [
      {
        "name": "userFLEX Session Capture",
        "schemes": [
          "userflex-session"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "userFLEX Session Manager",
      "runAfterFinish": false
    }
  }
}
