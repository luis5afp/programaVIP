{
  "name": "userflex-session-manager",
  "private": true,
  "version": "0.1.3",
  "description": "userFLEX managed Chromium session capture helper",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "socks": "^2.8.10"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.userflex.sessionmanager",
    "productName": "userFLEX Session Manager",
    "artifactName": "userFLEX-Session-Manager-${version}-Setup.${ext}",
    "asar": true,
    "files": [
      "main.js",
      "proxy-bridge.js",
      "preload.cjs",
      "package.json"
    ],
    "protocols": [
      {
        "name": "userFLEX Session Capture",
        "schemes": [
          "userflex-session"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "userFLEX Session Manager",
      "runAfterFinish": false
    }
  }
}
