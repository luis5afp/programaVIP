{
  "name": "userflow-client",
  "version": "0.3.39",
  "private": true,
  "type": "module",
  "description": "userFLOW para Windows",
  "main": "entry.js",
  "scripts": {
    "prestart": "node build/prepare-icon.mjs && node build/finalize-client-ui.mjs && node build/refresh-managed-session-catalog.mjs && node build/fix-splash-window-race.mjs && node build/direct-auto-update.mjs",
    "start": "electron .",
    "predist:win": "node build/prepare-icon.mjs && node build/finalize-client-ui.mjs && node build/refresh-managed-session-catalog.mjs && node build/fix-splash-window-race.mjs && node build/direct-auto-update.mjs",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@supabase/realtime-js": "^2.99.2",
    "socks": "^2.8.10",
    "puppeteer-core": "^24.17.1",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.userflex.client",
    "productName": "userFLOW",
    "asar": true,
    "electronVersion": "44.1.0+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterPack": "build/vmp-sign.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "entry.js",
      "startup.js",
      "bootstrap.js",
      "main.js",
      "widevine-runtime.js",
      "proxy-bridge.js",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "browser.html",
      "browser.css",
      "browser-renderer.js",
      "browser-preload.cjs",
      "profile-window.html",
      "profile-window.css",
      "profile-window-renderer.js",
      "profile-preload.cjs",
      "assets/**",
      "browser-engine/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "browser-engine/extension",
        "to": "browser-engine/extension"
      }
    ],
    "win": {
      "icon": "assets/userflow.png",
      "executableName": "userFLEX Client",
      "target": [
        "nsis"
      ],
      "artifactName": "userFLOW-${version}-Setup.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "userFLOW",
      "runAfterFinish": true
    },
    "protocols": [
      {
        "name": "userFLOW Client Test",
        "schemes": [
          "userflow-client"
        ]
      }
    ]
  }
}
