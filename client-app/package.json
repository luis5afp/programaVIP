{
  "name": "userflow-client",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "userFLOW para Windows",
  "main": "bootstrap.js",
  "scripts": {
    "start": "node prepare-icon.js && electron .",
    "dist:win": "node prepare-icon.js && electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.userflex.client",
    "productName": "userFLOW",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "bootstrap.js",
      "main.js",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "browser.html",
      "browser.css",
      "browser-renderer.js",
      "browser-preload.cjs",
      "assets/**",
      "package.json"
    ],
    "win": {
      "icon": "assets/userflow.png",
      "executableName": "userFLEX Client",
      "target": [
        "nsis"
      ],
      "artifactName": "userFLOW-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "userFLOW"
    }
  }
}
