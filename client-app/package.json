{
  "name": "userflow-client",
  "version": "0.2.38",
  "private": true,
  "type": "module",
  "description": "userFLOW para Windows",
  "main": "entry.js",
  "scripts": {
    "prestart": "node build/prepare-icon.mjs && node build/optimize-profile-runtime.mjs",
    "start": "electron .",
    "predist:win": "node build/prepare-icon.mjs && node build/optimize-profile-runtime.mjs",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "socks": "^2.8.10"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.userflex.client",
    "productName": "userFLOW",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "entry.js",
      "startup.js",
      "bootstrap.js",
      "main.js",
      "proxy-bridge.js",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "browser.html",
      "browser.css",
      "browser-renderer.js",
      "browser-preload.cjs",
      "profile-window.html",
      "profile-window.css",
      "profile-window-renderer.js",
      "profile-preload.cjs",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/session-manager/userFLEX-Session-Manager-Setup.exe",
        "to": "session-manager/userFLEX-Session-Manager-Setup.exe"
      }
    ],
    "win": {
      "icon": "assets/userflow.png",
      "executableName": "userFLEX Client",
      "target": [
        "nsis"
      ],
      "artifactName": "userFLOW-${version}-Setup.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "userFLOW",
      "runAfterFinish": true
    }
  }
}
